<section class="brutal"><header><h1>BRUTAL <small>RPG</small></h1><input name="name" value="{{actor.name}}" placeholder="Nome do personagem"/></header><div class="hero"><img src="{{actor.img}}" data-action="editImage" data-field="img"/><div><label>Estereótipo</label><select name="system.stereotype"><option value="" disabled {{#unless system.stereotype}}selected{{/unless}}>Selecione um estereótipo</option>{{#each stereotypes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><label>Iniciativa</label><input type="number" name="system.initiative" value="{{system.initiative}}"/><label>Atributo bônus</label><input name="system.bonusAttribute" value="{{system.bonusAttribute}}"/></div></div><h2>ATRIBUTOS — CLIQUE PARA ROLAR</h2><div class="attrs">{{#each attributes}}<div class="attr"><button type="button" data-action="roll" data-attribute="{{key}}">{{label}} 🎲</button><label>Treinado <input type="checkbox" name="system.attributes.{{key}}.trained" {{#if data.trained}}checked{{/if}}/></label><label>Bônus <input type="number" min="0" max="2" name="system.attributes.{{key}}.bonus" value="{{data.bonus}}"/></label></div>{{/each}}</div><h2>RECURSOS</h2><div class="resources"><label>Dados disponíveis <input type="number" min="0" name="system.pool" value="{{system.pool}}"/></label><label>Shots <input type="number" min="0" name="system.shots" value="{{system.shots}}"/></label><label>Tesão <input type="number" min="0" name="system.tesao" value="{{system.tesao}}"/></label><button type="button" data-action="shot">+1 Shot</button></div><div class="training"><label>Treinado em Shots <input type="checkbox" name="system.shotsTrained" {{#if system.shotsTrained}}checked{{/if}}/></label><label>Treinado em Tesão <input type="checkbox" name="system.tesaoTrained" {{#if system.tesaoTrained}}checked{{/if}}/></label></div><h2>HABILIDADE ESPECIAL</h2><textarea name="system.ability">{{system.ability}}</textarea><h2>HISTÓRIA</h2><textarea name="system.background">{{system.background}}</textarea><h2>EQUIPAMENTO</h2><textarea name="system.equipment">{{system.equipment}}</textarea></section>