<section class="brutal">
  <header>
    <h1>BRUTAL <small>RPG</small></h1>
    <input name="name" value="{{actor.name}}" aria-label="Nome" />
    <p>Cena {{scene}}</p>
  </header>
  {{#if gm}}
  <div class="resources">
    <button type="button" data-action="panel">Painel da Diretora</button>
    <button type="button" data-action="macros">Criar macros</button>
  </div>
  {{/if}}
  {{#if killer}}
  <div class="resources">
    <label>Pilha da Diretora <input type="number" min="0" name="system.pool" value="{{system.pool}}" /></label>
    <label>Pontos de Horror <input type="number" min="0" name="system.horror" value="{{system.horror}}" /></label>
  </div>
  <h2>Ameaças</h2>
  <div class="resources">
    <label>Principal <input name="system.primary" value="{{system.primary}}" /></label>
    <label>NB principal <input type="number" min="2" max="6" name="system.primaryLevel" value="{{system.primaryLevel}}" /></label>
    <label>Secundária <input name="system.secondary" value="{{system.secondary}}" /></label>
    <label>NB secundário <input type="number" min="2" max="6" name="system.secondaryLevel" value="{{system.secondaryLevel}}" /></label>
    {{#if gm}}<button type="button" data-action="initialize">Definir pilha e PH iniciais</button>{{/if}}
  </div>
  <label>Poder passivo <textarea name="system.passive">{{system.passive}}</textarea></label>
  <label>Poder especial <textarea name="system.special">{{system.special}}</textarea></label>
  <label>Ações únicas <textarea name="system.uniqueActions">{{system.uniqueActions}}</textarea></label>
  {{else}}
  <div class="hero">
    <img src="{{actor.img}}" data-action="editImage" data-field="img" alt="" />
    <div>
      <label>Arquétipo <select name="system.stereotype">
        <option value="" disabled {{#unless system.stereotype}}selected{{/unless}}>Selecione</option>
        {{#each archetypes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select></label>
      <label>Atributo Bônus <select name="system.bonusAttribute">
        <option value="">{{#if bonusAttributes}}Selecione{{else}}Todos os atributos estão treinados{{/if}}</option>
        {{#each bonusAttributes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select></label>
    </div>
  </div>
  <h2>Atributos</h2>
  {{#if missingSpecialties}}<p>Complete as duas especialidades da Sobrevivente.</p>{{/if}}
  <div class="attrs">
    {{#each attributes}}
    <div class="attr">
      <button type="button" data-action="test" data-test="risk" data-attribute="{{key}}">{{label}}</button>
      <label>Especialidade <input type="checkbox" name="system.attributes.{{key}}.trained" {{#if trained}}checked{{/if}} /></label>
    </div>
    {{/each}}
  </div>
  <h2>Pilhas e condições</h2>
  <div class="resources">
    <label>Dados comuns <input type="number" min="0" max="6" name="system.pool" value="{{system.pool}}" /></label>
    <label>Dados de fuga <input type="number" min="0" name="system.escapeDice" value="{{system.escapeDice}}" /></label>
    <label>Pontos de Tensão <input type="number" min="0" max="10" name="system.tension" value="{{system.tension}}" /></label>
    <label>Feridas <input type="number" min="0" max="6" name="system.wounds" value="{{system.wounds}}" /></label>
    <label>Sequelas <input type="number" min="0" max="5" name="system.sequelae" value="{{system.sequelae}}" /></label>
    <label>Escapou <input type="checkbox" name="system.escaped" {{#if system.escaped}}checked{{/if}} /></label>
    <label>Morreu <input type="checkbox" name="system.dead" {{#if system.dead}}checked{{/if}} /></label>
  </div>
  <h2>Ações</h2>
  <div class="resources">
    <button type="button" data-action="test" data-test="fright">Teste de susto</button>
    <button type="button" data-action="offer">Ofertar no Rito</button>
    {{#if encounter}}
    <button type="button" data-action="test" data-test="escape">Vazar Dali</button>
    <button type="button" data-action="test" data-test="fight">Partir para Cima</button>
    <button type="button" data-action="test" data-test="distract">Distrair</button>
    <button type="button" data-action="test" data-test="help">Ajudar Alguém</button>
    <button type="button" data-action="request" data-request="breathe">Recuperar o Fôlego</button>
    <button type="button" data-action="request" data-request="allIn">Arriscar Tudo</button>
    {{else}}
    <button type="button" data-action="request" data-request="reality">Choque de Realidade</button>
    <button type="button" data-action="request" data-request="heal">Cuidar de Feridas</button>
    {{/if}}
  </div>
  <h2>Apegos</h2>
  <div class="resources">
    <label>Item icônico <input name="system.iconicItem" value="{{system.iconicItem}}" /></label>
    <button type="button" data-action="request" data-request="iconic">Pedir +1 PT</button>
    <label>Relação afetiva <input name="system.relationship" value="{{system.relationship}}" /></label>
    <button type="button" data-action="request" data-request="relationship">Pedir +2 PT</button>
    <label>Desejo obscuro <input name="system.desire" value="{{system.desire}}" /></label>
    <button type="button" data-action="request" data-request="desire">Pedir +3 PT</button>
  </div>
  <label>Habilidades <textarea name="system.ability">{{system.ability}}</textarea></label>
  <label>Cicatrizes <textarea name="system.scars">{{system.scars}}</textarea></label>
  <label>História <textarea name="system.background">{{system.background}}</textarea></label>
  <label>Equipamento e recursos <textarea name="system.equipment">{{system.equipment}}</textarea></label>
  {{/if}}
</section>
